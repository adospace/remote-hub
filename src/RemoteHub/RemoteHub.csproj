<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>RemoteHub</RootNamespace>
    <AssemblyName>RemoteHub</AssemblyName>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <StartupObject>RemoteHub.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml must be compiled as a Page, not an ApplicationDefinition: an ApplicationDefinition
         generates its own Main, which conflicts with Program.Main. Program.Main has to exist so
         VelopackApp.Build().Run() can execute before anything else (install/update hooks). -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon assets embedded for the window/taskbar and the command-bar logo. -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteHub.Core\RemoteHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
