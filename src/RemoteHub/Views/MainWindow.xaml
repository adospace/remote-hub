<Window x:Class="RemoteHub.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RemoteHub.ViewModels"
        Title="RemoteHub" Height="800" Width="1200"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Import from RDM…" Command="{Binding ImportRdmCommand}" />
                <Separator />
                <MenuItem Header="New _Folder" Command="{Binding NewFolderCommand}" />
                <MenuItem Header="New _Connection" Command="{Binding NewConnectionCommand}" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" />
                <MenuItem Header="Se_ttings…" Command="{Binding OpenSettingsCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding ConnectionsFilePath}" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: connection tree (placeholder until Implement phase adds templates). -->
            <TreeView Grid.Column="0"
                      ItemsSource="{Binding RootNodes}"
                      Margin="4" />

            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- Right: open session tabs. -->
            <TabControl Grid.Column="2"
                        Margin="4"
                        ItemsSource="{Binding Sessions.Sessions}"
                        SelectedItem="{Binding Sessions.SelectedSession}" />
        </Grid>
    </DockPanel>
</Window>
