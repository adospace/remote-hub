<Window x:Class="RemoteHub.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RemoteHub.ViewModels"
        xmlns:controls="clr-namespace:RemoteHub.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RemoteHub" Height="800" Width="1200" MinWidth="820" MinHeight="480"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None"
        Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <!-- Custom chrome: the top 40px is the draggable caption; buttons/tabs/splitter opt back
         into hit testing via WindowChrome.IsHitTestVisibleInChrome so they stay clickable. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Editor for the search box. The stock Fluent TextBox paints its own surface, border and
             focus underline, which showed through as a second box sitting inside the rounded border
             around it — most visibly while typing. Setting Background/BorderThickness on the control
             does not help: those states are painted by elements *inside* its template. So replace the
             template with just the content host and let the surrounding Border be the only visual.
             Losing the template also loses its built-in clear button, hence the explicit one below. -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      Background="Transparent"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tree row: Fluent glyph (folder / open folder / monitor) + name. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Connect"
                                  Visibility="{Binding IsConnection, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding PlacementTarget.Tag.ConnectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Pin"
                                  Visibility="{Binding CanPin, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding PlacementTarget.Tag.PinNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Unpin"
                                  Visibility="{Binding CanUnpin, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding PlacementTarget.Tag.UnpinNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator Visibility="{Binding IsConnection, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="New Folder"
                                  Visibility="{Binding IsRealNode, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding PlacementTarget.Tag.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="New Connection"
                                  Visibility="{Binding IsRealNode, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding PlacementTarget.Tag.NewConnectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator Visibility="{Binding IsRealNode, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Edit"
                                  Visibility="{Binding IsRealNode, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding PlacementTarget.Tag.EditNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Rename"
                                  Visibility="{Binding IsRealNode, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding PlacementTarget.Tag.RenameNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Delete"
                                  Visibility="{Binding IsRealNode, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </StackPanel.ContextMenu>

                <TextBlock Margin="0,0,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphIcon}">
                            <!-- Everything is grey at rest. The accent is reserved for one meaning
                                 only — this connection has a LIVE session — so a coloured row in the
                                 tree reads as "connected" at a glance rather than just "is a
                                 connection". Keep it that way when adding states here. -->
                            <Setter Property="Text" Value="&#xE7F4;" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <!-- Folder (collapsed). -->
                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                    <Setter Property="Text" Value="&#xE8B7;" />
                                </DataTrigger>
                                <!-- Folder (expanded) -> open-folder glyph. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsFolder}" Value="True" />
                                        <Condition Binding="{Binding IsExpanded}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Text" Value="&#xE838;" />
                                </MultiDataTrigger>
                                <!-- Synthetic Pinned group -> pin glyph (grey: it is a container). -->
                                <DataTrigger Binding="{Binding IsPinnedContainer}" Value="True">
                                    <Setter Property="Text" Value="&#xE718;" />
                                </DataTrigger>
                                <!-- Connected: the one place the accent is used. Declared last so it
                                     wins over the states above. -->
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <!-- Host, dimmed and smaller: secondary information, and the reason a row that does
                     not look like a match shows up when searching by host. Folders have none.
                     Secondary, not Tertiary: measured on the light theme's nav surface, tertiary
                     came out at ~2:1 against the background — visibly washed out at 11px. -->
                <TextBlock Text="{Binding Host}" VerticalAlignment="Center" Margin="8,1,0,0"
                           FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasHost, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Tab header: connection name + close button. The per-session actions live centered on
             top of the RDP surface (see RdpSessionView). -->
        <DataTemplate x:Key="SessionHeaderTemplate" DataType="{x:Type vm:SessionViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE7F4;" FontSize="14" Margin="0,0,8,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Style="{StaticResource TabActionButton}" ToolTip="Close"
                        Command="{Binding DataContext.Sessions.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        CommandParameter="{Binding}">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE711;" FontSize="12" />
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- Tab body: the hosted RDP session view. -->
        <DataTemplate x:Key="SessionContentTemplate" DataType="{x:Type vm:SessionViewModel}">
            <controls:RdpSessionView />
        </DataTemplate>

        <!-- Modern Fluent "card" tab: rounded top, subtle hover, selected tab merges into the
             content surface below it. -->
        <Style x:Key="FluentTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- Three stacked layers, deliberately — this is a colour-matching device,
                             not decoration. LayerFillColorDefault is a semi-transparent white, so its
                             result depends on what sits behind it. The session surface a selected tab
                             must merge into accumulates it three times (empty-state Grid -> the
                             TabControlEx content Border -> RdpSessionView's toolbar strip) and lands
                             near-white, while a single layer here sits straight on the darker caption
                             band and lands visibly greyer — that is why the selected tab used to read
                             as barely different from the unselected ones. Repeating the stack matches
                             the surface exactly, in light AND dark, without hard-coding a colour.
                             Keep these in sync if the layering of the content surface changes. -->
                        <Border x:Name="BdUnder2" Background="Transparent" CornerRadius="8,8,0,0"
                                SnapsToDevicePixels="True">
                            <Border x:Name="BdUnder" Background="Transparent" CornerRadius="8,8,0,0"
                                    SnapsToDevicePixels="True">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8,8,0,0"
                                        Padding="12,0" SnapsToDevicePixels="True">
                                    <ContentPresenter x:Name="Content" ContentSource="Header"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <!-- Declared after the hover trigger so a selected tab keeps the surface
                                 colour while hovered. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BdUnder2" Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                                <Setter TargetName="BdUnder" Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact toggle that opens the "show all tabs" overflow menu (glyph E712). -->
        <Style x:Key="OverflowToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu-like row for the overflow list (borderless, rounded hover/selection). The selected
             row's fill doubles as the "current tab" indicator. -->
        <Style x:Key="OverflowListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControlEx keeps each session's view (and live RDP control) alive across tab switches.
             The header strip lives in the top caption band (fixed 40px, hit-test-visible), leaving
             room on the right for the window caption buttons. -->
        <Style TargetType="{x:Type controls:TabControlEx}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource FluentTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:TabControlEx}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Header strip: a single, non-wrapping, horizontally-clipping row of
                                 tabs plus a trailing overflow ("...") button. Right margin reserves
                                 room only for the window caption buttons (~144) — the session action
                                 bar has moved out of the caption band (req 1).

                                 IsHitTestVisibleInChrome goes on the interactive children ONLY, never
                                 on this Grid: anything marked opts OUT of the WindowChrome caption
                                 drag zone, so marking the whole strip made the empty space beside the
                                 tabs dead — the window could not be dragged there. -->
                            <Grid Grid.Row="0" Panel.ZIndex="1" Margin="8,0,144,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Non-wrapping tab host. Hidden H-scrollbar clips overflow to one
                                     line while still tracking ScrollableWidth (our overflow signal);
                                     Disabled V-scrollbar pins everything to a single 40px row.
                                     HorizontalAlignment=Left shrinks it to the tabs' own width (it
                                     still grows to fill and scroll when they overflow), so the strip
                                     claims no more of the caption band than the tabs actually need
                                     and the rest stays draggable. -->
                                <ScrollViewer x:Name="PART_HeaderScroller" Grid.Column="0"
                                              Focusable="False"
                                              HorizontalAlignment="Left"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                                </ScrollViewer>

                                <!-- Overflow menu: visible only when the strip actually overflows. -->
                                <ToggleButton x:Name="OverflowToggle" Grid.Column="1"
                                              Style="{StaticResource OverflowToggleButton}"
                                              ToolTip="Show all tabs"
                                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                              Visibility="{Binding ScrollableWidth, ElementName=PART_HeaderScroller, Converter={StaticResource GreaterThanZeroToVis}}">
                                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE712;" FontSize="16" />
                                </ToggleButton>

                                <Popup Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Fade" HorizontalOffset="-206"
                                       PlacementTarget="{Binding ElementName=OverflowToggle}"
                                       IsOpen="{Binding IsChecked, ElementName=OverflowToggle, Mode=TwoWay}"
                                       DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="4"
                                            MinWidth="240" MaxHeight="440" Margin="6,6,6,10">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Direction="270" />
                                        </Border.Effect>
                                        <!-- Plain paths resolve against the Popup DataContext (= the
                                             TabControlEx set just above). SelectedItem TwoWay switches
                                             the tab; ItemsSource is the live Sessions collection. -->
                                        <ListBox Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource OverflowListItem}"
                                                 PreviewMouseLeftButtonUp="OnOverflowItemClicked"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemsSource="{Binding ItemsSource}"
                                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SessionViewModel}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE7F4;"
                                                                   FontSize="14" Margin="0,0,10,0"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                            <!-- Inset the session surface by the resize-border width. A connected
                                 session hosts the RDP ActiveX in a WindowsFormsHost — an HWND, which
                                 eats the mouse wherever it covers, including the window's bottom/right
                                 resize grips (WindowChrome puts those INSIDE the client area). Without
                                 this the window cannot be resized from those edges while connected.
                                 Padding, not Margin, so the Border's own background fills the strip.
                                 Maximized has nothing to resize, so it goes flush. -->
                            <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Padding" Value="0,0,6,6" />
                                        <Style.Triggers>
                                            <DataTrigger Value="Maximized"
                                                         Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Setter Property="Padding" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid x:Name="PART_ItemsHolder" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window caption buttons (minimize / maximize-restore / close). -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button: red hover, matching the Windows caption convention. -->
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B02616" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root: two columns (nav | content) split by a full-height splitter that sits on the nav
         pane's right edge, so the content half starts flush against the divider. Three rows: the
         40px caption band, the body, and the update banner. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="300" MinWidth="220" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <!-- Update banner: zero-height until an update is available. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left surface + full-height divider on its right edge. -->
        <Border Grid.Column="0" Grid.RowSpan="2"
                Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0" />

        <!-- Left toolbar: app icon + name on the left, compact action buttons on the right. -->
        <Grid Grid.Column="0" Grid.Row="0" Margin="12,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"
                       Source="pack://application:,,,/Assets/app-icon.png"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="RemoteHub" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconBarButton}" Command="{Binding NewFolderCommand}"
                        ToolTip="New folder">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE8F4;" />
                </Button>
                <Button Style="{StaticResource IconBarButton}" Command="{Binding NewConnectionCommand}"
                        ToolTip="New connection">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE710;" />
                </Button>
                <Button Style="{StaticResource IconBarButton}" Command="{Binding OpenSettingsCommand}"
                        ToolTip="Settings">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Left: search box over the connection tree, filling the rest of the nav pane. -->
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Filter box. Typing filters the tree below as you type (SearchText is bound with
                 UpdateSourceTrigger=PropertyChanged); Escape or the trailing "x" clears it. This
                 Border is the entire visual — see the SearchTextBox style. -->
            <Border Grid.Row="0" Margin="10,4,10,6" Padding="8,0" CornerRadius="6"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource GlyphIcon}" Text="&#xE721;"
                               FontSize="14" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Esc" Command="{Binding ClearSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <!-- Watermark: shown only while the box is empty, and never hit-testable so
                             clicking it still lands in the TextBox underneath. -->
                        <TextBlock Text="Search name or host" VerticalAlignment="Center" Margin="2,0,0,0"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Clear button: only while there is something to clear. -->
                    <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                            Focusable="False">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE711;" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <TreeView x:Name="ConnectionsTree" Grid.Row="1"
                      Background="Transparent" BorderThickness="0" Padding="6,0,6,8"
                      ItemsSource="{Binding RootNodes}"
                      SelectedItemChanged="OnTreeSelectedItemChanged"
                      MouseDoubleClick="OnTreeMouseDoubleClick"
                      KeyDown="OnTreeKeyDown">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <!-- Overlays the (empty) tree when a search matched nothing. -->
            <TextBlock Grid.Row="1" Margin="16,10" TextWrapping="Wrap"
                       Text="No connections match your search."
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Visibility="{Binding NoSearchResults, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Full-height splitter pinned to the nav pane's right edge (over the divider), so the
             content half aligns flush against the border. -->
        <GridSplitter Grid.Column="0" Grid.RowSpan="2" Width="6" Background="Transparent"
                      HorizontalAlignment="Right" VerticalAlignment="Stretch" Panel.ZIndex="5"
                      ResizeBehavior="CurrentAndNext" ResizeDirection="Columns"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True" />

        <!-- Right content surface (empty state). -->
        <Grid Grid.Column="1" Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Sessions.NoSessions, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE7F4;" FontSize="48"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No active sessions" FontSize="18" Margin="0,16,0,4"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Select a connection and press Enter, or double-click it to connect."
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Session tabs: header strip sits in the caption band, content fills the body. -->
        <controls:TabControlEx Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                    Background="Transparent" BorderThickness="0"
                    Visibility="{Binding Sessions.HasSessions, Converter={StaticResource BoolToVis}}"
                    ItemsSource="{Binding Sessions.Sessions}"
                    SelectedItem="{Binding Sessions.SelectedSession}"
                    ItemTemplate="{StaticResource SessionHeaderTemplate}"
                    ContentTemplate="{StaticResource SessionContentTemplate}" />

        <!-- Window caption buttons, pinned to the top-right of the content half. -->
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick"
                    ToolTip="Minimize" Content="&#xE921;" />
            <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButton}"
                    Click="OnMaximizeRestoreClick" ToolTip="Maximize" Content="&#xE922;" />
            <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick"
                    ToolTip="Close" Content="&#xE8BB;" />
        </StackPanel>

        <!-- Update banner: a full-width strip across the bottom of the window. It must own a real
             layout row — a WPF overlay over the session surface would be hidden by the RDP
             WindowsFormsHost (an HWND paints above ALL WPF content, regardless of Z-order). The
             TabControlEx covers rows 0-1 of this Grid (its template re-partitions that space into
             the 40px header band + the content body), so row 2 is the only space the HWND can never
             reach. Auto row + collapsed root Border => no footprint when there is no update. -->
        <controls:UpdateBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            DataContext="{Binding Update}" />
    </Grid>
</Window>
