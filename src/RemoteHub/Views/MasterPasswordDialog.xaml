<Window x:Class="RemoteHub.Views.MasterPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master Password"
        SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock x:Name="Field1Label" Text="Master password" Margin="0,0,0,4" />
        <PasswordBox x:Name="Password1" Margin="0,0,0,12" />

        <TextBlock x:Name="Field2Label" Text="Confirm master password" Margin="0,0,0,4" />
        <PasswordBox x:Name="Password2" Margin="0,0,0,12" />

        <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
