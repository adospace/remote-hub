<Window x:Class="RemoteHub.Views.ConnectionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RemoteHub.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ConnectionEditorViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Connection" Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- No password field is ever presented; credentials are prompted at connect time. -->
                <TextBlock Text="Name" Margin="0,0,0,4" />
                <TextBox Text="{Binding Name}" Margin="0,0,0,12" />

                <TextBlock Text="Host" Margin="0,0,0,4" />
                <TextBox Text="{Binding Host}" Margin="0,0,0,12" />

                <TextBlock Text="Port" Margin="0,0,0,4" />
                <TextBox Text="{Binding Port}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,12" />

                <TextBlock Text="Username" Margin="0,0,0,4" />
                <TextBox Text="{Binding Username}" Margin="0,0,0,12" />

                <TextBlock Text="Domain" Margin="0,0,0,4" />
                <TextBox Text="{Binding Domain}" Margin="0,0,0,12" />

                <TextBlock Text="Description" Margin="0,0,0,4" />
                <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="48" Margin="0,0,0,16" />

                <TextBlock Text="Password" Margin="0,0,0,4" />
                <!-- Editable only when a master password is set and unlocked. -->
                <StackPanel Visibility="{Binding CanStorePassword, Converter={StaticResource B2V}}">
                    <PasswordBox x:Name="PasswordInput" Margin="0,0,0,4" />
                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Encrypted with your master password. Leave blank to keep the current one." />
                    <CheckBox Content="Clear saved password" IsChecked="{Binding ClearStoredPassword}"
                              Margin="0,0,0,16"
                              Visibility="{Binding HasStoredPassword, Converter={StaticResource B2V}}" />
                </StackPanel>
                <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="Set a master password in Settings to store credentials."
                           Visibility="{Binding CannotStorePassword, Converter={StaticResource B2V}}" />

                <TextBlock Text="Display" FontWeight="SemiBold" Margin="0,0,0,8" />

                <TextBlock Text="Screen mode" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding ScreenModes}" SelectedItem="{Binding ScreenMode}"
                          Width="200" HorizontalAlignment="Left" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Width" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DesktopWidth}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Height" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DesktopHeight}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Color depth" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding ColorDepths}" SelectedItem="{Binding ColorDepth}"
                          Width="200" HorizontalAlignment="Left" Margin="0,0,0,12" />

                <TextBlock Text="Audio" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AudioModes}" SelectedItem="{Binding Audio}"
                          Width="200" HorizontalAlignment="Left" Margin="0,0,0,12" />

                <CheckBox Content="Full screen" IsChecked="{Binding FullScreen}" Margin="0,0,0,8" />
                <CheckBox Content="Redirect clipboard" IsChecked="{Binding RedirectClipboard}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
