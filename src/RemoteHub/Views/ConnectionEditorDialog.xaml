<Window x:Class="RemoteHub.Views.ConnectionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection" Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Field editors are added during the Implement phase; no password field ever. -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Name" Margin="0,0,0,4" />
            <TextBox Text="{Binding Name}" Margin="0,0,0,12" />
            <TextBlock Text="Host" Margin="0,0,0,4" />
            <TextBox Text="{Binding Host}" Margin="0,0,0,12" />
            <TextBlock Text="Port" Margin="0,0,0,4" />
            <TextBox Text="{Binding Port}" Width="100" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
