<UserControl x:Class="RemoteHub.Controls.UpdateBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RemoteHub.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:UpdateViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Declared locally: MainWindow's BoolToVis lives in its Window.Resources and is not
             reachable from inside this control's own tree (same pattern as RdpSessionView). -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Accent "call to action" button. The app's shared CommandBarButton is subtle
             (transparent until hover), so the primary action gets its own accent-filled
             template rather than a BasedOn override of every brush. -->
        <Style x:Key="AccentActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="6" Padding="14,6" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- DataContext is the UpdateViewModel (set by MainWindow). The divider sits on TOP: this is a
         strip across the bottom of the window, reading as a footer under both the nav pane and the
         content half. Collapsed until an update exists, so it costs no pixels in the Auto row.
         Padding's 8px bottom is load-bearing: WindowChrome.ResizeBorderThickness is 6px, so
         anything closer to the bottom edge is swallowed by the resize grip and unclickable. -->
    <Border Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8"
            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
        <DockPanel>
            <!-- Right: actions. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Primary action, once the download has landed. -->
                <Button Command="{Binding InstallUpdateCommand}"
                        Margin="0,0,8,0"
                        Visibility="{Binding IsUpdateDownloaded, Converter={StaticResource BoolToVis}}">
                    <!-- Disabled while installing. A DataTrigger inverts IsInstalling in place,
                         so no inverse-bool converter is needed for this one binding. -->
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AccentActionButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE72C;" FontSize="12"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock Text="Restart to update" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>

                <!-- Recovery action. Gated on CanRetryDownload, not HasError: an install failure
                     also sets HasError, and retrying there would re-download an update that is
                     already on disk. -->
                <Button Command="{Binding RetryDownloadCommand}"
                        Style="{StaticResource CommandBarButton}"
                        Margin="0,0,4,0"
                        Visibility="{Binding CanRetryDownload, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Retry" FontSize="12" VerticalAlignment="Center" />
                </Button>

                <Button Command="{Binding DismissUpdateCommand}"
                        Style="{StaticResource TabActionButton}" ToolTip="Dismiss">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE711;" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>
            </StackPanel>

            <!-- Left: glyph + status + progress. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE896;" FontSize="14"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                    <TextBlock.ToolTip>
                        <StackPanel>
                            <TextBlock Text="{Binding UpdateVersion, StringFormat='New version: {0}'}" />
                            <TextBlock Text="{Binding AppVersion, StringFormat='Installed: {0}'}" />
                        </StackPanel>
                    </TextBlock.ToolTip>
                </TextBlock>

                <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <ProgressBar Value="{Binding DownloadProgress}" Maximum="100"
                             Width="120" Height="4" VerticalAlignment="Center"
                             Margin="0,0,12,0"
                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="360"
                           ToolTip="{Binding ErrorMessage}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
