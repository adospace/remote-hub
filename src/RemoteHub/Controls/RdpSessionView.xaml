<UserControl x:Class="RemoteHub.Controls.RdpSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             xmlns:vm="clr-namespace:RemoteHub.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SessionViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- Root is a DockPanel: a compact icon-only session toolbar docks at the top as a real
         strip (NOT a WPF overlay over the WindowsFormsHost, which would be occluded by airspace
         once connected). The host + disconnected overlay fill the rest (LastChildFill). -->
    <DockPanel LastChildFill="True">

        <!-- Session actions: centered, icon-only, tab-header button size (TabActionButton).
             DataContext is the SessionViewModel, so bind straight to its commands. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                <Button Style="{StaticResource TabActionButton}" ToolTip="Connect"
                        Command="{Binding ConnectCommand}">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE768;" FontSize="13"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Button>
                <Button Style="{StaticResource TabActionButton}" ToolTip="Disconnect"
                        Command="{Binding DisconnectCommand}">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE71A;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource TabActionButton}" ToolTip="Reconnect"
                        Command="{Binding ReconnectCommand}">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE72C;" FontSize="13" />
                </Button>
                <Border Width="1" Margin="5,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button Style="{StaticResource TabActionButton}" ToolTip="Full screen"
                        Command="{Binding FullScreenCommand}">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE740;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource TabActionButton}" ToolTip="Pop out to a separate window"
                        Command="{Binding PopOutCommand}">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE8A7;" FontSize="13" />
                </Button>
                <Border Width="1" Margin="5,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button Style="{StaticResource TabActionButton}" ToolTip="Edit connection"
                        Command="{Binding EditCommand}">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE70F;" FontSize="13" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Remote surface + disconnected overlay. Host and overlay never render at the same time:
             a WindowsFormsHost always paints above WPF content (airspace), so we collapse the host
             while disconnected and show the WPF overlay in its place. -->
        <Grid>
            <wf:WindowsFormsHost x:Name="RdpHostContainer"
                                 Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}" />

            <Border Background="#1E1E1E"
                    Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Disconnected"
                               Foreground="#EEEEEE" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Connection.Host}"
                               Foreground="#AAAAAA" FontSize="13" Margin="0,4,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StatusDetail}"
                               Foreground="#C08080" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <Button Content="Reconnect" Command="{Binding ConnectCommand}"
                            Margin="0,16,0,0" Padding="20,6" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
